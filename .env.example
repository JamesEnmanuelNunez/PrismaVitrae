# Supabase
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<your-anon-key>
# IMPORTANTE: debe ser la key "service_role" (Dashboard -> Settings -> API),
# NO la anon key. Se usa para scripts de admin y tests de auth.
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Google Gemini
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash

# App
APP_NAME=PrismaVitae
APP_ENV=development

# CORS (lista JSON de orígenes permitidos)
# CORS_ORIGINS=["http://localhost:5173","https://prismavitae.netlify.app"]

# Tamaño máximo de subida (MB)
# MAX_UPLOAD_MB=10